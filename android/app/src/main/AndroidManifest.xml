<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Map tiles and satellite imagery. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The map follows the car's GPS. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Wi-Fi and mobile signal for Yunus's top bar (normal permissions, granted at install). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Bluetooth on / connected for the status bar (normal permission up to Android 11). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- The Bluetooth panel switches Bluetooth and connects a paired phone (normal up to Android 11). -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- The bell in the status bar pulls down the notification shade (normal permission). -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- The car's signed-in user (name and photo) from BYD's account app (normal permission). -->
    <uses-permission android:name="com.byd.permission.ACCOUNT_SERVICE_LINK" />

    <!-- BYDAuto HAL _COMMON permissions (protectionLevel=dangerous, source package "android",
         so grantable to any app once the user approves — the same set BYD Road Computer and the
         electro reader hold). They let the app CONSTRUCT the HAL devices and register listeners;
         live data then arrives through the device push/listener path, which is not permission-gated.
         The signature _GET/_SET perms are NOT requested: they need BYD's platform certificate and
         no third-party app can hold them. -->
    <uses-permission android:name="android.permission.BYDAUTO_AC_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_BODYWORK_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_CHARGING_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_DOOR_LOCK_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_ENERGY_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_ENGINE_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_GEARBOX_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_INSTRUMENT_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_LIGHT_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_PM2P5_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_SAFETY_BELT_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_SETTING_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_SPEED_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_STATISTIC_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_TIME_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_TYRE_COMMON" />

    <!-- Android 11+ hides other apps unless declared: Yunus opens and embeds launchable apps
         (Google Maps, YouTube, …). -->
    <queries>
        <package android:name="com.byd.diLinkAccount" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Spoken navigation prompts (text-to-speech engine). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Music apps for the music card when none is open (see mediaApps), and starting them. -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
        <!-- Navigation apps for the map area (see navigationApps). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
    </queries>

    <application
        android:label="Yunus"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Yunus"
        android:hardwareAccelerated="true">

        <!-- The car's home screen (HOME), and still an app with a launcher icon. Made the default
             with `cmd package set-home-activity`; BYD's own home stays installed as the fallback. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Lets Yunus read the media sessions for the music card (now playing and its controls);
             no notifications are read. Enabled once by the owner in notification access. -->
        <service
            android:name=".MediaListener"
            android:label="Yunus müzik kartı"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
