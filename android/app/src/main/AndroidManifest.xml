<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Map tiles and satellite imagery. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The car's cameras in the page (getUserMedia); granted once over ADB (pm grant). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The map follows the car's GPS. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Wi-Fi and mobile signal for Yunus's top bar (normal permissions, granted at install). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Bluetooth on / connected for the status bar (normal permission up to Android 11). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- The Bluetooth panel switches Bluetooth and connects a paired phone (normal up to Android 11). -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- The swipe-up strip that brings Yunus back from any app (EdgeHome); granted over ADB. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- The bell in the status bar pulls down the notification shade (normal permission). -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- The car's signed-in user (name and photo) from BYD's account app (normal permission). -->
    <uses-permission android:name="com.byd.permission.ACCOUNT_SERVICE_LINK" />

    <!-- No BYDAuto HAL permissions (BYDAUTO_*_COMMON) on purpose: BYD's file manager refuses to
         install an app that asks for them ("Fail in installation of desktop apps", seen on an
         Atto 2), while Kinex and Electro, which ask for none, install. The car is read and driven
         through the shell helper over ADB, as Kinex and Electro do; CarHal still tries in-process
         and simply gets nothing where the image refuses it. -->
    <!-- The app tray's "Kaldır": Android's own uninstall screen. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Android 11+ hides other apps unless declared: Yunus opens and embeds launchable apps
         (Google Maps, YouTube, …). -->
    <queries>
        <package android:name="com.byd.diLinkAccount" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Spoken navigation prompts (text-to-speech engine). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Music apps for the music card when none is open (see mediaApps), and starting them. -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
        <!-- Navigation apps for the map area (see navigationApps). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
    </queries>

    <application
        android:label="Yunus"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Yunus"
        android:hardwareAccelerated="true">

        <!-- The car's home screen (HOME). It is installed DISABLED, the way Kinex ships: BYD's
             file manager refuses an APK whose enabled activity is a HOME screen ("Fail in
             installation of desktop apps", Atto 2 / Dolphin). MainActivity.onCreate enables it on
             the first start; it is then made the default with `cmd package set-home-activity`. BYD's
             own home stays installed as the fallback. -->
        <activity
            android:name=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- The launcher icon: enabled from install, opens MainActivity (as Kinex's MainActivityLauncher). -->
        <activity-alias
            android:name=".MainActivityLauncher"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Lets Yunus read the media sessions for the music card (now playing and its controls);
             no notifications are read. Enabled once by the owner in notification access. -->
        <service
            android:name=".MediaListener"
            android:label="Yunus müzik kartı"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
