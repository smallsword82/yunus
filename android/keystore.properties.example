# Kişisel release imzalama — bu dosyayı "keystore.properties" olarak kopyala ve kendi değerlerini yaz.
# keystore.properties repoya GİRMEZ (.gitignore'da). Anahtarı ve parolaları yalnız sen tutarsın;
# Yunus release'ini yalnız bu anahtarla imzalayabilirsin → APK "sana özel" olur.
#
# Anahtarı bir kez üret (android/ içinde):
#   keytool -genkeypair -v -keystore yunus-release.jks -alias yunus -keyalg RSA -keysize 2048 -validity 10000
# Sonra bu dosyayı doldur:

storeFile=yunus-release.jks
storePassword=DEGISTIR
keyAlias=yunus
keyPassword=DEGISTIR
